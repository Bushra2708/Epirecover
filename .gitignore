# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
.env

# Environment / secrets — NEVER commit these
.env
.env.local
.env.*.local

# Tesseract temp
temp.jpg

# Model weights — too large for Git
models/*.bin
models/*.pt
models/*.pth
models/*.onnx
models/*.index
models/*.faiss

# Generated outputs
outputs/predictions/*.json
outputs/visualizations/*.png
outputs/reports/*.log
outputs/reports/*.csv

# Dataset files — may be large or licensed
data/raw/
data/processed/
data/corpus/*.jsonl
data/corpus/*.csv
# Keep the synthetic fixture
!data/corpus/bharatshri_sample.jsonl

# Annotation files may contain sensitive ground-truth
data/annotations/*.json
data/annotations/*.csv

# IDE / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Streamlit cache
.streamlit/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/


# Node.js dependencies — do not upload to GitHub
node_modules/
frontend/node_modules/
backend/node_modules/

# Frontend build output
frontend/dist/
frontend/build/

# Node.js debug logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
