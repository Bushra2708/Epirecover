# EpiRecover — Environment Variables Template
# Copy to .env and fill in keys. Never commit .env to Git.

# ---- LLM backends (optional — system works offline without these) ----
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (automatic fallback): https://console.groq.com/keys
GROQ_API_KEY=

# ---- Tesseract (required for Tesseract OCR) ----
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Leave empty if tesseract is already on PATH.
TESSERACT_CMD=

# ---- Optional: custom paths (override config/epirecover.yaml) ----
EPIRECOVER_CONFIG=config/epirecover.yaml
EPIRECOVER_DATA_ROOT=data
EPIRECOVER_CORPUS_DIR=data/corpus

# ---- Research mode flags ----
# Set to "1" to disable all network calls (fully offline mode)
EPIRECOVER_OFFLINE=0

# Set to "1" to enable verbose debug logging
EPIRECOVER_DEBUG=0
